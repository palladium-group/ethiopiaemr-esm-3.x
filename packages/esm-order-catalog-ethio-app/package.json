{
  "name": "@palladium-ethiopia/esm-order-catalog-ethio-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Bahmni-style order catalog for lab, radiology, and procedure orders (Ethiopia EMR)",
  "browser": "dist/openmrs-esm-order-catalog-ethio-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "webpack serve --mode=development",
    "debug": "npm run serve",
    "build": "webpack --mode production --color",
    "analyze": "webpack --mode=production --env analyze=true",
    "lint": "cross-env eslint src --ext tsx,ts --fix --max-warnings=0",
    "test": "cross-env TZ=UTC jest --config jest.config.js --verbose false --passWithNoTests --color",
    "test:watch": "cross-env TZ=UTC jest --watch --config jest.config.js --color",
    "coverage": "yarn test --coverage",
    "typescript": "tsc",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/index.ts' --config ../../tools/i18next-parser.config.js"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "ethiopia",
    "orders"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/react": "^1.83.0",
    "@openmrs/esm-patient-common-lib": "^12.0.2-pre.10146"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "9.x",
    "@openmrs/esm-patient-common-lib": "12.x",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/esm-patient-common-lib": "^12.0.2-pre.10146",
    "webpack": "^5.99.9"
  }
}
