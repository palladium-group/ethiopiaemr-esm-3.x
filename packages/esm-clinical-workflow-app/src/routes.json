{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0"
  },
  "pages": [],
  "extensions": [
    {
      "name": "ewf-mru-dashboard-link",
      "component": "mruLeftPanelLink",
      "slot": "homepage-dashboard-slot",
      "order": 4,
      "meta": {
        "name": "mru",
        "title": "MRU",
        "path": "mru",
        "slot": "mru-dashboard-slot"
      }
    },
    {
      "name": "ewf-mru-dashboard",
      "component": "mruDashboard",
      "slot": "mru-dashboard-slot",
      "online": true,
      "offline": false
    },
    {
      "name": "order-sheet",
      "component": "orderSheet",
      "slot": "ewf-admissions-dashboard-slot",
      "online": true,
      "offline": false
    },
    {
      "name": "patient-scoreboard-link",
      "component": "patientScoreboardLink",
      "slot": "homepage-dashboard-slot",
      "order": 5,
      "meta": {
        "name": "patient-scoreboard",
        "title": "Patient Scoreboard",
        "path": "patient-scoreboard",
        "slot": "patient-scoreboard-slot"
      }
    },
    {
      "name": "patient-scoreboard",
      "component": "patientScoreboard",
      "slot": "patient-scoreboard-slot",
      "online": true,
      "offline": false
    },
    {
      "name": "past-visits-detail-overview-shadow",
      "slot": "patient-chart-encounters-dashboard-slot",
      "component": "pastVisitsDetailOverviewShadow",
      "order": 0,
      "meta": {
        "title": "Visits",
        "view": "visits"
      },
      "online": true,
      "offline": true
    },
    {
      "name": "diagnoses-summary-dashboard",
      "component": "diagnosesDashboardLink",
      "slot": "patient-chart-dashboard-slot",
      "meta": {
        "slot": "patient-chart-diagnoses-dashboard-slot",
        "path": "diagnoses",
        "hideDashboardTitle": true
      },
      "order": 8
    },
    {
      "name": "diagnoses-dashboard",
      "component": "diagnosesDashboard",
      "slot": "patient-chart-diagnoses-dashboard-slot",
      "meta": {
        "fullWidth": false
      }
    },
    {
      "name": "queue-table-transfer-column",
      "component": "queueTableTransferColumn",
      "slot": "queue-table-transfer-status-slot"
    },
    {
      "name": "queue-table-room-column",
      "component": "queueTableRoomColumn",
      "slot": "queue-table-room-assignment-slot"
    },
    {
      "name": "queue-table-actions-column",
      "component": "queueTableActionsColumn",
      "slot": "queue-table-actions-slot"
    },
    {
      "name": "service-queue-table-dashboard",
      "component": "serviceQueueTableDashboard",
      "slot": "service-queues-dashboard-slot",
      "order": 0,
      "online": true,
      "offline": true
    },
    {
      "name": "service-queues-dashboard-shell",
      "component": "serviceQueuesDashboardShell",
      "slot": "service-queues-dashboard-slot",
      "order": -20,
      "online": true,
      "offline": true
    },
    {
      "name": "clinical-metrics-card-checked-in-patients",
      "component": "clinicalMetricsCardCheckedInPatients",
      "slot": "service-queues-metrics-slot",
      "order": 1,
      "online": true,
      "offline": true
    },
    {
      "name": "transfer-notes-overview-widget",
      "component": "transferNotesOverview",
      "slot": "patient-chart-summary-dashboard-slot",
      "meta": {
        "fullWidth": false
      },
      "order": 6
    },
    {
      "name": "finish-service-button",
      "component": "finishServiceButton",
      "slot": "patient-banner-bottom-slot",
      "order": 3,
      "online": true,
      "offline": true
    },
    {
      "name": "start-visit-button2",
      "component": "startVisitActionButton",
      "slot": "patient-actions-slot",
      "online": true,
      "offline": true
    },
    {
      "name": "admit-patient-button",
      "component": "admitPatientActionButton",
      "slot": "patient-actions-slot",
      "online": true,
      "offline": true
    },
    {
      "name": "add-patient-to-ward-siderail-button",
      "component": "addPatientToWardSiderailButton",
      "slot": "ward-ui-extension-hidden-slot"
    },
    {
      "name": "ethiopia-admitted-patients-table",
      "component": "ethiopiaAdmittedPatientsTable",
      "slot": "ward-patients-admitted-slot"
    },
    {
      "name": "ethiopia-awaiting-admission-patients-table",
      "component": "ethiopiaAwaitingAdmissionPatientsTable",
      "slot": "ward-patients-awaiting-admission-slot"
    },
    {
      "name": "ethiopiaemr-etl-admin-dashboard-link",
      "component": "etlAdminDashboardLink",
      "slot": "navbar-items-slot",
      "online": true,
      "offline": false,
      "meta": {
        "search": ["etl", "ETL Administration"]
      }
    },
    {
      "name": "ethiopiaemr-shr-admin-dashboard-link",
      "component": "shrAdminDashboardLink",
      "slot": "navbar-items-slot",
      "online": true,
      "offline": false,
      "privilege": "Manage SHR Outbox",
      "meta": {
        "search": ["shr", "SHR Admin", "Shared Health Record", "outbox"]
      }
    },
    {
      "name": "ethiopiaemr-reports-dashboard-link",
      "component": "reportsDashboardLink",
      "slot": "navbar-items-slot",
      "online": true,
      "offline": false,
      "meta": {
        "search": ["reports", "Reports"]
      }
    },
    {
      "name": "recent-diagnoses-widget",
      "component": "recentDiagnosesWidget",
      "slot": "patient-chart-summary-dashboard-slot",
      "online": true,
      "offline": false
    },
    {
      "name": "immunization-register-action-button",
      "component": "immunizationRegisterActionButton",
      "slot": "patient-chart-immunizations-dashboard-slot"
    }
  ],
  "workspaces": [
    {
      "name": "patient-registration-workspace",
      "component": "patientRegistrationWorkspace",
      "title": "Patient Registration",
      "canMaximize": true,
      "type": "registration-form"
    },
    {
      "name": "billing-information-workspace",
      "component": "billingInformationWorkspace",
      "title": "Billing Information Workspace",
      "type": "clinical-form"
    }
  ],
  "workspaces2": [
    {
      "name": "clinical-workflow-patient-form-entry-workspace",
      "component": "@openmrs/esm-patient-forms-app#exportedPatientFormEntryWorkspace",
      "window": "clinical-workflow-window"
    },
    {
      "name": "patient-transfer-form-entry-workspace",
      "component": "@openmrs/esm-patient-forms-app#exportedPatientFormEntryWorkspace",
      "window": "patient-transfer"
    },
    {
      "name": "visit-notes-form-shadow-workspace",
      "component": "visitNotesFormWorkspace",
      "window": "visit-note-shadow"
    },
    {
      "name": "ethiopia-bed-swap-workspace",
      "component": "ethiopiaBedSwapWorkspace",
      "window": "kenyaemr-esm-ward-window"
    }
  ],
  "workspaceWindows2": [
    {
      "name": "patient-chart-order-basket-shadow",
      "icon": "orderBasketActionButton",
      "group": "patient-chart",
      "order": 1
    },
    {
      "name": "patient-chart-clinical-forms-shadow",
      "icon": "clinicalFormsActionButton",
      "group": "patient-chart",
      "order": 2
    },
    {
      "name": "clinical-workflow-window",
      "group": "clinical-workflow-group",
      "width": "wider",
      "canMaximize": true
    },
    {
      "name": "visit-note-shadow",
      "group": "patient-chart",
      "icon": "visitNoteActionButton",
      "order": 3
    },
    {
      "name": "patient-transfer",
      "group": "patient-chart",
      "icon": "patientTransferActionButton",
      "order": 4,
      "width": "wider",
      "canMaximize": true
    }
  ],
  "workspaceGroups2": [
    {
      "name": "clinical-workflow-group",
      "overlay": true,
      "persistence": "closable"
    }
  ],
  "modals": [
    {
      "name": "confirm-transfer-dialog",
      "component": "confirmTransferDialog"
    },
    {
      "name": "patient-transfer-details-modal",
      "component": "patientTransferDetailsModal"
    },
    {
      "name": "assign-queue-room-modal",
      "component": "assignQueueRoomModal"
    },
    {
      "name": "call-queue-entry-modal",
      "component": "callQueueEntryModal"
    }
  ]
}
