{
  "name": "@palladium-ethiopia/esm-referral-app",
  "version": "1.0.0",
  "description": "EthiopiaEMR referral app for OpenMRS 3 — liaison work lists, catchment, and closed-loop actions",
  "keywords": [
    "openmrs",
    "ethiopiaemr",
    "referral"
  ],
  "homepage": "https://github.com/palladium-group/ethiopiaemr-esm-3.x#readme",
  "bugs": {
    "url": "https://github.com/palladium-group/ethiopiaemr-esm-3.x/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palladium-group/ethiopiaemr-esm-3.x.git"
  },
  "license": "MPL-2.0",
  "main": "src/index.ts",
  "source": true,
  "browser": "dist/esm-referral-app.js",
  "scripts": {
    "analyze": "rspack --mode=production --env analyze=true",
    "build": "rspack --mode=production",
    "lint": "cross-env eslint src --ext ts,tsx",
    "serve": "rspack serve --mode=development",
    "start": "openmrs develop",
    "test": "cross-env TZ=UTC jest --config jest.config.js --verbose false --passWithNoTests --color",
    "typescript": "tsc",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/index.ts' --config ../../tools/i18next-parser.config.js"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "peerDependencies": {
    "@carbon/react": "^1.x",
    "@openmrs/esm-framework": "8.x",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "11.x",
    "react-router-dom": "6.x",
    "swr": "2.x"
  },
  "publishConfig": {
    "access": "public"
  }
}
