{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0"
  },
  "extensions": [
    {
      "name": "pathology-order-tile",
      "component": "pathologyOrderTile",
      "slot": "special-orders-slot",
      "order": 1
    },
    {
      "name": "pathology-dashboard-link",
      "component": "pathologyDashboardLink",
      "slot": "patient-chart-dashboard-slot",
      "order": 18,
      "meta": {
        "slot": "patient-chart-pathology-dashboard-slot",
        "path": "pathology",
        "title": "Pathology",
        "hideDashboardTitle": true
      }
    },
    {
      "name": "pathology-dashboard",
      "component": "pathologyDashboard",
      "slot": "patient-chart-pathology-dashboard-slot",
      "meta": {
        "fullWidth": true
      }
    }
  ],
  "workspaces2": [
    {
      "name": "pathology-order-workspace",
      "component": "pathologyOrderWorkspace",
      "window": "special-order-form"
    },
    {
      "name": "special-order-form-entry-workspace",
      "component": "@openmrs/esm-patient-forms-app#exportedPatientFormEntryWorkspace",
      "window": "special-order-form"
    }
  ],
  "workspaceWindows2": [
    {
      "name": "special-order-form",
      "group": "patient-chart",
      "width": "wider",
      "canMaximize": true
    }
  ]
}
