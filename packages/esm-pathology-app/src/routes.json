{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0"
  },
  "extensions": [
    {
      "name": "pathology-order-tile",
      "component": "pathologyOrderTile",
      "slot": "special-orders-slot",
      "order": 1
    },
    {
      "name": "pathology-results-dashboard-link",
      "component": "pathologyResultsDashboardLink",
      "slot": "patient-chart-dashboard-slot",
      "order": 18,
      "meta": {
        "slot": "patient-chart-pathology-results-dashboard-slot",
        "path": "pathology-results",
        "title": "Pathology Results"
      }
    },
    {
      "name": "pathology-results-dashboard",
      "component": "pathologyResults",
      "slot": "patient-chart-pathology-results-dashboard-slot",
      "meta": {
        "fullWidth": false
      }
    }
  ]
}
